FORPAY_APP_NAME=ForPay
# Compose 镜像。远程部署使用 litehub/forpay:0.1.2；源码构建时改为 forpay:local
FORPAY_IMAGE=litehub/forpay:latest
FORPAY_API_PORT=7500
POSTGRES_PASSWORD=请替换为强随机数据库密码
FORPAY_ENVIRONMENT=development
FORPAY_DATABASE_URL=postgresql+psycopg://forpay:forpay@localhost:5432/forpay
FORPAY_REDIS_URL=redis://localhost:6379/0
FORPAY_PUBLIC_BASE_URL=http://localhost:7500
FORPAY_CORS_ORIGINS=http://localhost:5173
FORPAY_SESSION_SECRET=change-this-in-development
FORPAY_ADMIN_TOKEN=change-this-before-production
FORPAY_MONITOR_TOKEN=change-this-monitor-token-before-production
FORPAY_ORDER_TTL_MINUTES=15
FORPAY_AMOUNT_SUFFIX_CENTS=1
FORPAY_UPDATE_MANIFEST_URL=
FORPAY_UPDATE_PUBLIC_KEY=
FORPAY_ENCRYPTION_KEY=
FORPAY_DB_POOL_SIZE=10
FORPAY_DB_MAX_OVERFLOW=20
FORPAY_DB_POOL_TIMEOUT=30
FORPAY_METRICS_ENABLED=true
FORPAY_WAF_ENABLED=true
